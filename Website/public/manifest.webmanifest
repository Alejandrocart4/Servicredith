{
  "name": "ServiCredith",
  "short_name": "ServiCredith",
  "description": "Sistema local de ventas, inventario y credito de ServiCredith.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#f4f8f5",
  "theme_color": "#1a7a3c",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/credithicon.svg",
      "sizes": "64x64",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
